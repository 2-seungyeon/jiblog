// Prisma schema for jiblog
// DATABASE_URL is loaded from `.env.local` via `dotenv-cli` (see package.json db:* scripts).
//
// Designed from lib/mock/homes.ts and lib/mock/home-store.ts.
// Migration and application wiring will be done in a later step.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ResidenceStatus {
  RESIDING   @map("거주 중")
  MOVING_OUT @map("이사 예정")
  PAST       @map("과거 거주")
}

enum ContractType {
  MONTHLY      @map("월세")
  JEONSE       @map("전세")
  SEMI_JEONSE  @map("반전세")
}

enum ContractStatus {
  ACTIVE @map("계약 진행 중")
}

enum PaymentStatus {
  SCHEDULED @map("예정")
  COMPLETED @map("완료")
}

enum ExpenseCategory {
  MAINTENANCE @map("관리비")
  ELECTRICITY @map("전기")
  GAS         @map("가스")
  WATER       @map("수도")
  INTERNET    @map("인터넷")
  OTHER       @map("기타")
}

// ─── Models ──────────────────────────────────────────────────────────────────

// Linked to Supabase Auth (auth.users). Prisma does not manage auth.users.
model User {
  id            String   @id
  name          String   @default("")
  email         String   @unique
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  homes Home[]
}

model Home {
  id              String          @id @default(cuid())
  userId          String?
  nickname        String
  address         String
  detailAddress   String?
  residenceStatus ResidenceStatus
  moveInDate      DateTime?       @db.Date
  isPrimary       Boolean         @default(false)
  memo            String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  contract        Contract?
  rentPayments    RentPayment[]
  expensePayments ExpensePayment[]

  @@index([isPrimary])
  @@index([userId])
  @@index([userId, isPrimary])
}

model Contract {
  id             String         @id @default(cuid())
  homeId         String         @unique
  type           ContractType
  startDate      DateTime       @db.Date
  endDate        DateTime       @db.Date
  deposit        Int
  monthlyRent    Int            @default(0)
  maintenanceFee Int            @default(0)
  status         ContractStatus @default(ACTIVE)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)
}

model RentPayment {
  id        String        @id @default(cuid())
  homeId    String
  yearMonth String
  amount    Int
  dueDay    Int
  status    PaymentStatus @default(SCHEDULED)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  // Same home cannot have duplicate rent records for the same billing month.
  @@unique([homeId, yearMonth])
  @@index([yearMonth])
  @@index([status])
}

model ExpensePayment {
  id        String          @id @default(cuid())
  homeId    String
  yearMonth String
  category  ExpenseCategory
  amount    Int
  dueDay    Int
  status    PaymentStatus   @default(SCHEDULED)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  home Home @relation(fields: [homeId], references: [id], onDelete: Cascade)

  // Same home can have multiple expense types per month, but not duplicate categories.
  @@unique([homeId, yearMonth, category])
  @@index([homeId, yearMonth])
  @@index([yearMonth])
  @@index([status])
}
